OPENROUTER_API_KEY=your-openrouter-key
SARVAM_API_KEY=your-sarvam-key
# optional
SECRET_KEY=change-me          # signs HOD approval links
PUBLIC_URL=http://localhost:8000
LLM_MODEL=anthropic/claude-sonnet-5.5
DATA_DIR=data/demo            # data/private for local real documents (gitignored)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# optional: real phone calls (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE=0   # set 1 to accept only requests signed by Twilio
# optional: the agent calls your phone (Plivo free trial can call numbers you verified)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM=          # your Plivo trial number, E.164
PLIVO_ALLOWED_TO=    # comma-separated numbers the agent may call, E.164
# optional: the agent calls your phone via Vonage (free trial calls your registered number)
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=   # default: vonage_private.key in the project folder (gitignored)
VONAGE_FROM=123456789      # trial test caller ID
VONAGE_ALLOWED_TO=         # comma-separated numbers the agent may call, with country code
